<?xml version="1.0" encoding="utf-8"?>
<!-- The picture the page drew, with the buttons over it where it drew them: 8 dp in from the right, then next
     (44 dp), play (52 dp) and previous (44 dp). Keep these in step with WIDGET_BTNS in app.html. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/w_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_open">
            <TextView
                android:id="@+id/w_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="@string/widget_fallback"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </FrameLayout>
        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/ic_n_prev"
            android:contentDescription="@string/prev" />
        <ImageView
            android:id="@+id/w_play"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/ic_n_play"
            android:contentDescription="@string/play" />
        <ImageView
            android:id="@+id/w_next"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/ic_n_next"
            android:contentDescription="@string/next" />
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
    </LinearLayout>
</FrameLayout>
